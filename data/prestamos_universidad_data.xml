<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_prestamo_prestamo" model="ir.sequence">
        <field name="name">Prestamo universitario</field>
        <field name="code">prestamo.prestamo</field>
        <field name="prefix">PU/%(year)s/</field>
        <field name="padding">5</field>
    </record>

    <record id="area_biblioteca" model="prestamo.area">
        <field name="name">Biblioteca Central</field>
        <field name="ubicacion">Campus principal</field>
    </record>

    <record id="area_laboratorio" model="prestamo.area">
        <field name="name">Laboratorio de Sistemas</field>
        <field name="ubicacion">Bloque Academico</field>
    </record>

    <record id="categoria_libros" model="prestamo.categoria">
        <field name="name">Libros academicos</field>
        <field name="tipo">libro</field>
    </record>

    <record id="categoria_laptops" model="prestamo.categoria">
        <field name="name">Laptops</field>
        <field name="tipo">equipo</field>
    </record>

    <record id="categoria_proyectores" model="prestamo.categoria">
        <field name="name">Proyectores</field>
        <field name="tipo">equipo</field>
    </record>
</odoo>
