<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="prestamo_mantenimiento_view_list" model="ir.ui.view">
        <field name="name">prestamo.mantenimiento.list</field>
        <field name="model">prestamo.mantenimiento</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="recurso_id"/>
                <field name="area_id"/>
                <field name="fecha_inicio"/>
                <field name="fecha_fin"/>
                <field name="responsable_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="prestamo_mantenimiento_view_search" model="ir.ui.view">
        <field name="name">prestamo.mantenimiento.search</field>
        <field name="model">prestamo.mantenimiento</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="recurso_id"/>
                <field name="area_id"/>
                <filter name="activos" string="Activos" domain="[('state', 'in', ['programado', 'proceso'])]"/>
                <filter name="finalizados" string="Finalizados" domain="[('state', '=', 'finalizado')]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_estado" string="Estado" context="{'group_by': 'state'}"/>
                    <filter name="group_area" string="Area" context="{'group_by': 'area_id'}"/>
                    <filter name="group_responsable" string="Responsable" context="{'group_by': 'responsable_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="prestamo_mantenimiento_view_form" model="ir.ui.view">
        <field name="name">prestamo.mantenimiento.form</field>
        <field name="model">prestamo.mantenimiento</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_iniciar" type="object" string="Iniciar" class="btn-primary" invisible="state != 'programado'"/>
                    <button name="action_finalizar" type="object" string="Finalizar" class="btn-primary" invisible="state != 'proceso'"/>
                    <button name="action_cancelar" type="object" string="Cancelar" invisible="state in ['finalizado', 'cancelado']"/>
                    <field name="state" widget="statusbar" statusbar_visible="programado,proceso,finalizado"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="recurso_id"/>
                            <field name="area_id"/>
                            <field name="responsable_id"/>
                        </group>
                        <group>
                            <field name="fecha_inicio"/>
                            <field name="fecha_fin"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Descripcion">
                            <field name="descripcion"/>
                        </page>
                        <page string="Resultado">
                            <field name="resultado"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="prestamo_mantenimiento_action" model="ir.actions.act_window">
        <field name="name">Mantenimientos</field>
        <field name="res_model">prestamo.mantenimiento</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_activos': 1}</field>
    </record>
</odoo>
