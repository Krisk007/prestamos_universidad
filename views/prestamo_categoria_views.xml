<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="prestamo_categoria_view_list" model="ir.ui.view">
        <field name="name">prestamo.categoria.list</field>
        <field name="model">prestamo.categoria</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="tipo"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="prestamo_categoria_view_form" model="ir.ui.view">
        <field name="name">prestamo.categoria.form</field>
        <field name="model">prestamo.categoria</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="tipo"/>
                        <field name="active"/>
                    </group>
                    <group>
                        <field name="descripcion"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="prestamo_categoria_action" model="ir.actions.act_window">
        <field name="name">Categorias</field>
        <field name="res_model">prestamo.categoria</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
