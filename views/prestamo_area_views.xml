<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="prestamo_area_view_list" model="ir.ui.view">
        <field name="name">prestamo.area.list</field>
        <field name="model">prestamo.area</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="responsable_id"/>
                <field name="ubicacion"/>
                <field name="email"/>
                <field name="telefono"/>
            </list>
        </field>
    </record>

    <record id="prestamo_area_view_form" model="ir.ui.view">
        <field name="name">prestamo.area.form</field>
        <field name="model">prestamo.area</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="responsable_id"/>
                            <field name="ubicacion"/>
                        </group>
                        <group>
                            <field name="email"/>
                            <field name="telefono"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="prestamo_area_action" model="ir.actions.act_window">
        <field name="name">Areas responsables</field>
        <field name="res_model">prestamo.area</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
